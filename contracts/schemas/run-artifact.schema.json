{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elevator.oosu.dev/contracts/run-artifact.schema.json",
  "title": "SimulationRunArtifact",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_version",
    "simulator_version",
    "run_id",
    "scenario",
    "policy",
    "seed",
    "sim_time",
    "trace_sha256",
    "metrics",
    "provenance",
    "trace_manifest",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "elevator-queue-lab.run.v1" },
    "artifact_version": { "type": "string" },
    "simulator_version": { "type": "string" },
    "run_id": { "type": "string", "minLength": 1 },
    "scenario": { "type": "string" },
    "policy": { "type": "string" },
    "seed": { "type": "integer" },
    "sim_time": { "type": "number", "minimum": 0 },
    "trace_sha256": { "type": ["string", "null"] },
    "metrics": { "type": "object" },
    "provenance": { "type": "object" },
    "trace_manifest": { "$ref": "trace-manifest.schema.json" },
    "created_at": { "type": "string" }
  }
}
