{
  "name": "elevator-queue-lab-ui-qa",
  "private": true,
  "scripts": {
    "frontend:install": "npm ci --prefix frontend",
    "frontend:typecheck": "npm run typecheck --prefix frontend",
    "frontend:test": "npm test --prefix frontend",
    "frontend:build": "npm run build --prefix frontend",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test tests/e2e/visual.spec.js --update-snapshots",
    "capture:showcase": "SHOWCASE=1 playwright test tests/e2e/showcase.spec.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0"
  }
}
